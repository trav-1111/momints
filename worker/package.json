{
  "name": "momints-roll-worker",
  "private": true,
  "version": "0.1.0",
  "description": "Momints roll backend: Cloudflare Worker + D1 + Turbo/Arweave. Single Worker (validated by spikes — see docs/spikes/irys/RESULT2.md and worker-turbo-spike/RESULT.md).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "node scripts/deploy-filmstocks.mjs",
    "deploy:worker": "npm run validate:filmstocks && node node_modules/wrangler/bin/wrangler.js --config wrangler.toml deploy",
    "deploy:production:maintenance": "npm run deploy:worker",
    "deploy:production:activate": "node scripts/deploy-production-active.mjs",
    "publish:filmstock": "node scripts/publish-filmstock.mjs",
    "schedule:filmstock": "node scripts/schedule-filmstock.mjs",
    "test:filmstocks": "node --test tests/filmstock-package.test.mjs",
    "test:roll-contract": "node --test tests/roll-frame-contract.test.mjs",
    "test:staging": "node --test tests/staging-tooling.test.mjs",
    "test:maintenance": "node --experimental-strip-types --test tests/maintenance.test.mjs",
    "test:production-tooling": "node --test tests/production-tooling.test.mjs",
    "test:production:maintenance": "node scripts/test-production-maintenance.mjs --confirm-read-only-production",
    "verify:production:identity": "node scripts/verify-local-production-identity.mjs",
    "verify:production:runtime": "node scripts/inspect-production-runtime.mjs --expect-active",
    "verify:production:readiness": "node scripts/verify-production-readiness.mjs --confirm-active-readiness",
    "test:migration-upgrade": "node scripts/test-migration-upgrade.mjs",
    "signer:production:public": "node scripts/derive-production-signer.mjs",
    "secrets:staging": "node scripts/configure-staging-secrets.mjs",
    "test:staging:deployed": "node scripts/test-staging-deployment.mjs --confirm-staging",
    "validate:filmstocks": "node scripts/validate-filmstocks.mjs",
    "typecheck": "tsc --noEmit",
    "bundle-size": "node node_modules/wrangler/bin/wrangler.js --config wrangler.toml deploy --dry-run --outdir .bundle-check",
    "db:migrate:local": "node node_modules/wrangler/bin/wrangler.js --config wrangler.toml d1 migrations apply momints-rolls --local",
    "db:migrate:remote": "node node_modules/wrangler/bin/wrangler.js --config wrangler.toml d1 migrations apply momints-rolls --remote"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.3.7",
    "@dha-team/arbundles": "^1.0.4",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@noble/hashes": "^1.8.0",
    "@solana/kit": "^5.5.0",
    "bs58": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260721.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "7.0.2",
    "wrangler": "4.113.0"
  }
}
