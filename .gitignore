# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json
credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
.env.*
!.env*.example
.dev.vars*
!.dev.vars*.example

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
/worker/filmstock-validation/
/worker/.staging-secrets/
/worker/.staging-evidence/
/worker/.production-evidence/
modules/*/android/build
modules/*/android/.cxx

# installed agent skills — vendored third-party content, re-created by
# `npx skills add <source>`. .claude/skills holds symlinks into .agents.
# skills-lock.json records the source + content hash; ignored with the rest,
# but it is the one piece worth committing if the skill set should be
# reproducible across machines.
/.agents
/.claude/skills
skills-lock.json

# Agent worktrees — scratch checkouts, never part of the repo. Three of these
# were once committed as accidental gitlinks; this stops that recurring.
/.claude/worktrees

# Private, retained authoring material (not submission content)
/.claude/settings.local.json
/worker/filmstock-drafts/
/worker/scripts/make-bali-starter-contact.mjs

# Generated native/module and package outputs
modules/*/android/.gradle/
*.apk
*.aab
/worker/wrangler.review.local.toml

# Scratch testing screenshots
after_exposure.png
camera_screen.png
exposing_*.png
review_*.png
