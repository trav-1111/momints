# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json
credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# installed agent skills — vendored third-party content, re-created by
# `npx skills add <source>`. .claude/skills holds symlinks into .agents.
# skills-lock.json records the source + content hash; ignored with the rest,
# but it is the one piece worth committing if the skill set should be
# reproducible across machines.
/.agents
/.claude/skills
skills-lock.json
