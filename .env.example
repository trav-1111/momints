# Solana RPC — mainnet endpoint (Helius, QuickNode, Triton, etc.)
EXPO_PUBLIC_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=your_key_here

# Treasury — receives the prepaid roll fee AND the per-shot quick-mint fee.
# Must match the Worker's QUICK_TREASURY_ADDRESS (wrangler.toml [vars]): the
# Worker verifies quick-mint AND roll-fee payment to this exact address out of
# the landed transaction, so a mismatch rejects a fee the user already paid.
EXPO_PUBLIC_ROLL_TREASURY=your_treasury_wallet_address_here

# Roll backend Worker — REQUIRED. Server-side pipeline (permanent Arweave
# storage via Turbo, Worker-signed frame mints, no wallet approval per frame)
# for both rolls and quick mints. There is no on-device fallback — leaving
# this unset makes roll/quick-mint actions fail with a clear "not configured"
# error rather than silently falling back to a different, less-verified path.
EXPO_PUBLIC_ROLL_API=https://momints-roll-worker.your-subdomain.workers.dev
