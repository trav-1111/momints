# Pinata IPFS — get keys from https://app.pinata.cloud/developers/api-keys
EXPO_PUBLIC_PINATA_JWT=your_pinata_jwt_here
EXPO_PUBLIC_PINATA_GATEWAY=your-gateway.mypinata.cloud

# Solana RPC — mainnet endpoint (Helius, QuickNode, Triton, etc.)
EXPO_PUBLIC_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=your_key_here

# Treasury — receives the prepaid roll fee AND the per-shot quick-mint fee.
# Must match the Worker's QUICK_TREASURY_ADDRESS (wrangler.toml [vars]): the
# Worker verifies quick-mint payment to that exact address out of the landed
# transaction, so a mismatch rejects finalizes the user has already paid for.
EXPO_PUBLIC_ROLL_TREASURY=your_treasury_wallet_address_here

# Roll backend Worker — server-side roll pipeline (Arweave/Irys storage, Worker-signed
# frame mints, no wallet approval per frame). Leave UNSET to keep the on-device path
# (Pinata/IPFS uploads + MWA-signed mints). Devnet only.
EXPO_PUBLIC_ROLL_API=https://momints-roll-worker.your-subdomain.workers.dev
