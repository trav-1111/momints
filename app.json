{
  "expo": {
    "scheme": "momints",
    "userInterfaceStyle": "dark",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0a0f1a"
    },
    "web": {
      "output": "static"
    },
    "name": "Momints",
    "slug": "momints",
    "version": "1.0.0",
    "android": {
      "package": "com.momints.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f1a"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.momints.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Momints needs camera access to capture photos for minting as NFTs",
        "NSPhotoLibraryUsageDescription": "Momints needs photo library access to save photos"
      }
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Momints needs camera access to capture photos for minting as NFTs"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b3603ed4-6ea4-4b24-957c-4c048d7158f6"
      }
    },
    "owner": "trav_1111"
  }
}
